# MongoDB connection string. Local Docker default:
MONGODB_URI=mongodb://127.0.0.1:27017/smart-class

# API port. The Vite dev server proxies /api to localhost:5000.
PORT=5000

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# IANA timezone used for "today", the fee month, and late attendance.
APP_TIMEZONE=Asia/Colombo

# Scans at or after this local time are marked Late. 24-hour HH:MM.
CLASS_LATE_AFTER=16:15

# Shown beside fee amounts. Examples: Rs. or LKR
CURRENCY=Rs.

# Used when a student has no fee record for the selected month yet.
DEFAULT_MONTHLY_FEE=1000

# Optional on your own machine. Production will not start until this is set.
# Guardian phone numbers are stored, so use a long password before sharing the site.
APP_PASSWORD=

# Shown in the sidebar and the browser tab.
CLASS_NAME=Smart Class Mathematics
TEACHER_NAME=Chamal Wakwella
TEACHER_PHONE=0764629455

# Leave empty when Express serves the dashboard (Render / Railway).
# Set to the API origin, without a trailing slash, if the UI is hosted separately.
VITE_API_URL=
